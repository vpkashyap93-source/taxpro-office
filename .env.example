# Copy to .env.local and adjust. Never commit real secrets.

# SQLite database file (relational; schema is portable to Postgres via Drizzle)
DATABASE_PATH=./data/taxpro.db

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Document storage driver: "local" (default) — cloud drivers can be added in src/server/storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads

# Max upload size in MB
UPLOAD_MAX_MB=15

# Demo password assigned to seeded users (only used by `npm run db:seed`)
SEED_DEMO_PASSWORD=TaxPro@2026

# Show demo credentials on the login screen (set to false in production)
SHOW_DEMO_LOGINS=true

# Allow session cookies over plain http (only for LAN/phone testing; keep unset in production)
# COOKIE_SECURE=false
